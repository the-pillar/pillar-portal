NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Supabase (`pnpm exec supabase start`). The key is the CLI's fixed demo
# publishable key, the same on every machine, and works only against the
# local stack. `pnpm exec supabase status -o env` prints the current local
# values (API_URL and PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Prototype persona sign-in on /login (AD-7). It may be on only against the
# local stack or the staging project; the server refuses to start otherwise.
# The password is the one supabase/seed.sql gives the local persona users, so
# the two must match. Staging's is generated and set on Vercel, never here.
PROTOTYPE_PERSONAS=true
PROTOTYPE_PERSONA_PASSWORD=local-persona-password

# Server-only: the local stack's secret key, for the error recorder and
# /api/health (src/lib/supabase/admin.ts). The server refuses to start
# without it. Copy SECRET_KEY from `pnpm exec supabase status -o env`; it is
# left empty here so no secret key is ever committed.
SUPABASE_SECRET_KEY=

# Server-only: the email sender (src/features/email). Sink mode, the default,
# runs the whole send path but records each email in memory instead of sending
# it. "send" really sends through Resend and is refused outside production;
# set it, the key, the webhook secret and the From address on the production Vercel project only.
# The limits are Resend's free plan (100 a day, 3,000 a month), counted in UTC,
# and the daily cap on confirmation and status-code emails inside it.
EMAIL_MODE=sink
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
EMAIL_CONFIRMATION_DAILY_CAP=30
